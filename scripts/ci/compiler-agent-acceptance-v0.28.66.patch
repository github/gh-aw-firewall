+func TestValidateCloudHypervisorAgentAcceptanceSchemaBudget(t *testing.T) {
+	for _, tc := range []struct {
+		name    string
+		tokens  int
+		feature any
+		runtime string
+		valid   bool
+	}{
+		{"ordinary ceiling", 32768, nil, "", true},
+		{"ordinary larger", 32769, nil, "", false},
+		{"ordinary acceptance budget", 131072, nil, "", false},
+		{"missing feature", 131072, nil, "cloud-hypervisor", false},
+		{"disabled feature", 131072, false, "cloud-hypervisor", false},
+		{"string feature", 131072, "true", "cloud-hypervisor", false},
+		{"missing primary", 131072, true, "", false},
+		{"Docker primary", 131072, true, "docker", false},
+		{"acceptance allowance", 131072, true, "cloud-hypervisor", true},
+		{"acceptance overflow", 131073, true, "cloud-hypervisor", false},
+		{"acceptance invalid", 0, true, "cloud-hypervisor", false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			data := map[string]any{
+				"on":     "workflow_dispatch",
+				"engine": "copilot",
+				"enclaves": []any{map[string]any{
+					"agent": map[string]any{
+						"model": "claude-sonnet-5", "max-model-tokens": tc.tokens,
+					},
+					"repos": []any{map[string]any{"repo": "github/gh-aw-firewall", "sensitivity": "public"}},
+				}},
+			}
+			if tc.feature != nil {
+				data["features"] = map[string]any{cloudHypervisorAgentAcceptanceFeature: tc.feature}
+			}
+			if tc.runtime != "" {
+				data["sandbox"] = map[string]any{"agent": map[string]any{"id": "awf", "runtime": tc.runtime}}
+			}
+			err := parser.ValidateMainWorkflowFrontmatterWithSchemaAndLocation(data, "workflow.md")
+			if tc.valid {
+				require.NoError(t, err)
+			} else {
+				require.Error(t, err)
+			}
+		})
+	}
 }
 
