diff --git a/pkg/parser/schema_test.go b/pkg/parser/schema_test.go
--- a/pkg/parser/schema_test.go
+++ b/pkg/parser/schema_test.go
@@ -3844,0 +3845,44 @@
+
+func TestMainWorkflowSchemaOrdinaryEnclaveTokenLimitAndEvals(t *testing.T) {
+	question := map[string]any{"id": "review", "question": "Did the workflow complete?"}
+	tests := []struct {
+		name      string
+		maxTokens int
+		evals     any
+		wantValid bool
+	}{
+		{"ordinary token limit", 32768, nil, true},
+		{"ordinary token limit exceeded", 32769, nil, false},
+		{"array evals", 32768, []any{question}, true},
+		{"object evals", 32768, map[string]any{"questions": []any{question}}, true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			frontmatter := map[string]any{
+				"on":     "workflow_dispatch",
+				"engine": "copilot",
+				"enclaves": []any{
+					map[string]any{
+						"agent": map[string]any{
+							"model":            "gpt-5",
+							"max-model-tokens": tt.maxTokens,
+						},
+						"repos": []any{
+							map[string]any{"repo": "octo-org/private-service", "sensitivity": "confidential"},
+						},
+					},
+				},
+			}
+			if tt.evals != nil {
+				frontmatter["evals"] = tt.evals
+			}
+			err := ValidateMainWorkflowFrontmatterWithSchemaAndLocation(frontmatter, "workflow.md")
+			if tt.wantValid && err != nil {
+				t.Fatalf("expected frontmatter to validate: %v", err)
+			}
+			if !tt.wantValid && err == nil {
+				t.Fatal("expected ordinary enclave token limit to be enforced")
+			}
+		})
+	}
+}
