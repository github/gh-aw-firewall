+
+/// Scoped switch of the calling thread's filesystem uid/gid.
+///
+/// Linux keeps fsuid/fsgid per thread, and the switch is undone on drop, so a
+/// creation performed while the guard is alive is permission-checked and owned
+/// as the requested identity without affecting other threads.
+pub struct FsCredentials {
+    previous_uid: libc::uid_t,
+    previous_gid: libc::gid_t,
+}
+
+impl FsCredentials {
+    pub fn switch(uid: lx::uid_t, gid: lx::gid_t) -> lx::Result<Self> {
+        // SAFETY: setfsuid/setfsgid only change the calling thread's
+        // filesystem credentials; passing u32::MAX (-1) queries without change.
+        unsafe {
+            let previous_gid = libc::setfsgid(gid) as libc::gid_t;
+            if libc::setfsgid(libc::gid_t::MAX) as libc::gid_t != gid {
+                libc::setfsgid(previous_gid);
+                return Err(lx::Error::EPERM);
+            }
+            let previous_uid = libc::setfsuid(uid) as libc::uid_t;
+            if libc::setfsuid(libc::uid_t::MAX) as libc::uid_t != uid {
+                libc::setfsuid(previous_uid);
+                libc::setfsgid(previous_gid);
+                return Err(lx::Error::EPERM);
+            }
+            Ok(Self {
+                previous_uid,
+                previous_gid,
+            })
+        }
+    }
+}
+
+impl Drop for FsCredentials {
+    fn drop(&mut self) {
+        // SAFETY: Restores the thread's filesystem credentials saved by
+        // `switch`, which were valid for this thread.
+        unsafe {
+            libc::setfsuid(self.previous_uid);
+            libc::setfsgid(self.previous_gid);
+        }
+    }
+}
