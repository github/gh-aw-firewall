+/// Host identity used for guest requests on the microVM virtio-fs attachment.
+#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]
+pub enum MicroVmCreateOwner {
+    /// Every request runs as the OpenVMM process identity (historical behavior).
+    #[default]
+    Process,
+    /// Every request runs as the guest caller's uid/gid, like virtiofsd, so
+    /// guest-created objects are owned by the guest user on the host. Guest
+    /// uid 0 and gid 0 are squashed to the export root's owner.
+    Caller,
+}
+
+impl MicroVmCreateOwner {
+    /// The HostFs `mount_options` value that selects [`Self::Caller`].
+    pub const CALLER_MOUNT_OPTION: &'static str = "owner=caller";
+
+    /// Parses the microVM HostFs mount options; only the owner option is accepted.
+    pub fn from_mount_options(options: &str) -> anyhow::Result<Self> {
+        match options {
+            "" => Ok(Self::Process),
+            Self::CALLER_MOUNT_OPTION if cfg!(unix) => Ok(Self::Caller),
+            _ => anyhow::bail!(
+                "microVM virtio-fs accepts only the '{}' HostFs mount option on Unix",
+                Self::CALLER_MOUNT_OPTION
+            ),
+        }
+    }
+}
+
+/// Host identity mapping for [`MicroVmCreateOwner::Caller`].
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct CallerIdentity {
+    squash_uid: lx::uid_t,
+    squash_gid: lx::gid_t,
+}
+
+impl CallerIdentity {
+    /// Returns the host uid/gid for a guest request.
+    pub fn map(&self, uid: lx::uid_t, gid: lx::gid_t) -> (lx::uid_t, lx::gid_t) {
+        (
+            if uid == 0 { self.squash_uid } else { uid },
+            if gid == 0 { self.squash_gid } else { gid },
+        )
+    }
+}
