+/// Scoped switch of the calling thread's filesystem identity.
+///
+/// Linux keeps fsuid/fsgid and supplementary groups per thread, so while the
+/// guard is alive every filesystem operation on this thread is
+/// permission-checked, and every new object is owned, as the requested
+/// identity. Supplementary groups are cleared so that the process's group
+/// memberships grant no extra access. Other threads are unaffected, and the
+/// previous identity is restored on drop. Switching to an identity other than
+/// the current one requires `CAP_SETUID`/`CAP_SETGID`; without them `switch`
+/// fails with `EPERM` instead of silently keeping the old identity.
+pub struct FsCredentials {
+    previous_uid: libc::uid_t,
+    previous_gid: libc::gid_t,
+    previous_groups: Vec<libc::gid_t>,
+}
+
+impl FsCredentials {
+    /// Switches the calling thread to `uid`/`gid` until the guard is dropped.
+    pub fn switch(uid: lx::uid_t, gid: lx::gid_t) -> lx::Result<Self> {
+        let previous_groups = thread_groups()?;
+        if !previous_groups.is_empty() {
+            set_thread_groups(&[])?;
+        }
+        // SAFETY: setfsuid/setfsgid only change the calling thread's
+        // filesystem credentials; `u32::MAX` (-1) queries without changing.
+        unsafe {
+            let previous_gid = libc::setfsgid(gid) as libc::gid_t;
+            if libc::setfsgid(libc::gid_t::MAX) as libc::gid_t != gid {
+                libc::setfsgid(previous_gid);
+                let _ = set_thread_groups(&previous_groups);
+                return Err(lx::Error::EPERM);
+            }
+            let previous_uid = libc::setfsuid(uid) as libc::uid_t;
+            if libc::setfsuid(libc::uid_t::MAX) as libc::uid_t != uid {
+                libc::setfsuid(previous_uid);
+                libc::setfsgid(previous_gid);
+                let _ = set_thread_groups(&previous_groups);
+                return Err(lx::Error::EPERM);
+            }
+            Ok(Self {
+                previous_uid,
+                previous_gid,
+                previous_groups,
+            })
+        }
+    }
+}
+
+impl Drop for FsCredentials {
+    fn drop(&mut self) {
+        // SAFETY: Restores this thread's filesystem credentials saved by
+        // `switch`.
+        unsafe {
+            libc::setfsuid(self.previous_uid);
+            libc::setfsgid(self.previous_gid);
+        }
+        if !self.previous_groups.is_empty() {
+            let _ = set_thread_groups(&self.previous_groups);
+        }
+    }
+}
+
+/// Returns the calling thread's supplementary groups.
+fn thread_groups() -> lx::Result<Vec<libc::gid_t>> {
+    // SAFETY: A zero-sized query writes nothing.
+    let count = unsafe { libc::getgroups(0, std::ptr::null_mut()) };
+    if count < 0 {
+        return Err(lx::Error::last_os_error());
+    }
+    let mut groups = vec![0; count as usize];
+    if count > 0 {
+        // SAFETY: `groups` has room for `count` entries.
+        let count = unsafe { libc::getgroups(count, groups.as_mut_ptr()) };
+        if count < 0 {
+            return Err(lx::Error::last_os_error());
+        }
+        groups.truncate(count as usize);
+    }
+    Ok(groups)
+}
+
+/// Sets the calling thread's supplementary groups.
+///
+/// Uses the raw syscall because glibc's `setgroups` applies the change to
+/// every thread in the process.
+fn set_thread_groups(groups: &[libc::gid_t]) -> lx::Result<()> {
+    // SAFETY: `groups` is valid for `groups.len()` entries.
+    let ret = unsafe { libc::syscall(libc::SYS_setgroups, groups.len(), groups.as_ptr()) };
+    if ret != 0 {
+        return Err(lx::Error::last_os_error());
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod fs_credentials_tests {
+    use super::FsCredentials;
+    use super::set_thread_groups;
+    use super::thread_groups;
+
+    fn fs_ids() -> (libc::uid_t, libc::gid_t) {
+        // SAFETY: -1 queries the current values without changing them.
+        unsafe {
+            (
+                libc::setfsuid(libc::uid_t::MAX) as libc::uid_t,
+                libc::setfsgid(libc::gid_t::MAX) as libc::gid_t,
+            )
+        }
+    }
+
+    #[test]
+    fn switch_to_current_identity_and_restore() {
+        let (uid, gid) = fs_ids();
+        let groups = thread_groups().unwrap();
+        match FsCredentials::switch(uid, gid) {
+            Ok(guard) => {
+                assert!(thread_groups().unwrap().is_empty());
+                drop(guard);
+            }
+            // Clearing supplementary groups requires CAP_SETGID.
+            // SAFETY: geteuid has no side effects.
+            Err(_) => assert!(!groups.is_empty() && unsafe { libc::geteuid() } != 0),
+        }
+        assert_eq!(fs_ids(), (uid, gid));
+        assert_eq!(thread_groups().unwrap(), groups);
+    }
+
+    #[test]
+    fn switch_clears_groups_on_this_thread_only() {
+        // SAFETY: geteuid has no side effects.
+        if unsafe { libc::geteuid() } != 0 {
+            return;
+        }
+        let groups = thread_groups().unwrap();
+        set_thread_groups(&[4242]).unwrap();
+        let barrier = std::sync::Arc::new(std::sync::Barrier::new(2));
+        let other = std::thread::spawn({
+            let barrier = barrier.clone();
+            move || {
+                barrier.wait();
+                let groups = thread_groups().unwrap();
+                barrier.wait();
+                groups
+            }
+        });
+        let guard = FsCredentials::switch(1001, 1001).unwrap();
+        assert!(thread_groups().unwrap().is_empty());
+        barrier.wait();
+        barrier.wait();
+        assert_eq!(other.join().unwrap(), [4242]);
+        drop(guard);
+        assert_eq!(thread_groups().unwrap(), [4242]);
+        set_thread_groups(&groups).unwrap();
+    }
+
+    #[test]
+    fn switch_fails_closed_without_capability() {
+        // SAFETY: geteuid has no side effects.
+        if unsafe { libc::geteuid() } == 0 {
+            return;
+        }
+        let (uid, gid) = fs_ids();
+        let groups = thread_groups().unwrap();
+        assert!(FsCredentials::switch(u32::MAX - 7, u32::MAX - 7).is_err());
+        assert_eq!(fs_ids(), (uid, gid));
+        assert_eq!(thread_groups().unwrap(), groups);
+    }
+}
