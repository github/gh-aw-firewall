+/// Host identity used for guest requests on the microVM virtio-fs attachment.
+#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]
+pub enum MicroVmCreateOwner {
+    /// Every request runs as the OpenVMM process identity (historical behavior).
+    #[default]
+    Process,
+    /// Every request runs as a host identity derived from the guest caller,
+    /// like virtiofsd, so guest-created objects are owned by the guest user on
+    /// the host. The FUSE uid/gid are guest-controlled, so only the configured
+    /// workload uid/gid pass through; any other id, including 0, is squashed
+    /// to the export root's owner.
+    Caller {
+        /// The guest workload identity allowed to pass through.
+        workload: Option<(lx::uid_t, lx::gid_t)>,
+    },
+}
+
+impl MicroVmCreateOwner {
+    /// The HostFs `mount_options` prefix that selects [`Self::Caller`].
+    pub const CALLER_MOUNT_OPTION: &'static str = "owner=caller";
+
+    /// Parses the microVM HostFs mount options; only the owner option is
+    /// accepted, as `owner=caller` or `owner=caller:<UID>:<GID>`.
+    pub fn from_mount_options(options: &str) -> anyhow::Result<Self> {
+        if options.is_empty() {
+            return Ok(Self::Process);
+        }
+        let invalid = || {
+            anyhow::anyhow!(
+                "microVM virtio-fs accepts only the '{0}' or '{0}:<UID>:<GID>' HostFs mount option on Unix",
+                Self::CALLER_MOUNT_OPTION
+            )
+        };
+        if !cfg!(unix) {
+            return Err(invalid());
+        }
+        let rest = options
+            .strip_prefix(Self::CALLER_MOUNT_OPTION)
+            .ok_or_else(invalid)?;
+        if rest.is_empty() {
+            return Ok(Self::Caller { workload: None });
+        }
+        let (uid, gid) = rest
+            .strip_prefix(':')
+            .and_then(|ids| ids.split_once(':'))
+            .ok_or_else(invalid)?;
+        let uid = uid.parse::<lx::uid_t>().map_err(|_| invalid())?;
+        let gid = gid.parse::<lx::gid_t>().map_err(|_| invalid())?;
+        anyhow::ensure!(
+            uid != 0 && gid != 0,
+            "microVM virtio-fs caller workload identity must be nonzero"
+        );
+        Ok(Self::Caller {
+            workload: Some((uid, gid)),
+        })
+    }
+}
+
+/// Host identity mapping for [`MicroVmCreateOwner::Caller`].
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct CallerIdentity {
+    squash_uid: lx::uid_t,
+    squash_gid: lx::gid_t,
+    workload: Option<(lx::uid_t, lx::gid_t)>,
+}
+
+impl CallerIdentity {
+    /// Returns the host uid/gid for a guest request.
+    ///
+    /// The configured workload uid/gid map to themselves; every other guest
+    /// id, including 0, maps to the export root's owner, so a guest cannot
+    /// act as an arbitrary host account by forging FUSE request ids.
+    pub fn map(&self, uid: lx::uid_t, gid: lx::gid_t) -> (lx::uid_t, lx::gid_t) {
+        let (workload_uid, workload_gid) = match self.workload {
+            Some((uid, gid)) => (Some(uid), Some(gid)),
+            None => (None, None),
+        };
+        (
+            if Some(uid) == workload_uid {
+                uid
+            } else {
+                self.squash_uid
+            },
+            if Some(gid) == workload_gid {
+                gid
+            } else {
+                self.squash_gid
+            },
+        )
+    }
+}
