// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`generateSquidConfig golden output preserves SSL Bump with URL filtering and CLI proxy byte-for-byte 1`] = `
"# Squid configuration for egress traffic control
# Generated by awf

# SSL Bump mode enabled - HTTPS traffic will be intercepted for URL inspection

# Disable pinger (ICMP) - requires NET_RAW capability which we don't have for security
pinger_enable off

# PID file location - use proxy-owned directory since container runs as non-root
pid_filename /var/run/squid/squid.pid

# Custom log format with detailed connection information
# Format: timestamp client_ip:port dest_domain dest_ip:port protocol method status decision url user_agent
# Note: For CONNECT requests (HTTPS), the domain is in the URL field
logformat firewall_detailed %ts.%03tu %>a:%>p %{Host}>h %<a:%<p %rv %rm %>Hs %Ss:%Sh %ru "%{User-Agent}>h"

# Structured JSONL audit log for machine-readable analysis
# Note: Squid logformat does not JSON-escape strings, so fields like User-Agent
# could break JSON parsing. We omit User-Agent to reduce breakage risk.
logformat audit_jsonl {"_schema":"audit/v0.0.0-test","timestamp":"%{%Y-%m-%dT%H:%M:%S}tg.%03tuZ","event":"http_access","client":"%>a","host":"%{Host}>h","dest":"%<a:%<p","method":"%rm","status":%>Hs,"decision":"%Ss","url":"%ru"}

# Access log and cache configuration
# Keep logs readable by the host runner for post-run redaction.
umask 022
# Don't log healthcheck probes from localhost (using ACL filter on access_log)
acl healthcheck_localhost src 127.0.0.1 ::1
acl sensitive_log_domains dstdomain .github.com

access_log /var/log/squid/access.log firewall_detailed !healthcheck_localhost !sensitive_log_domains 
access_log /var/log/squid/audit.jsonl audit_jsonl !healthcheck_localhost !sensitive_log_domains 
cache_log /var/log/squid/cache.log
cache deny all

# ACL definitions for allowed domains (HTTP and HTTPS)
acl allowed_domains dstdomain .github.com

# ACL definitions for allowed domain patterns (HTTP and HTTPS)
acl allowed_domains_regex dstdom_regex -i ^[a-zA-Z0-9.-]*\\.example\\.org$
acl from_cli_proxy src 172.30.0.50/32
acl cli_proxy_artifact_storage dstdomain .blob.core.windows.net

# Port configuration


# SSL Bump configuration for HTTPS content inspection
# Authenticate upstreams against AWF's filtered bundle AND hashed directory.
tls_outgoing_options cafile=/etc/ssl/certs/ca-certificates.crt capath=/etc/ssl/certs
sslproxy_cert_error deny all
# WARNING: This enables TLS interception - traffic is decrypted for inspection
# A per-session CA certificate is used for dynamic certificate generation

# HTTP port with SSL Bump enabled for HTTPS interception
# This handles both HTTP requests and HTTPS CONNECT requests
# Listen on both IPv4 and IPv6 as defense-in-depth (see: gh-aw-firewall issue #1543)
http_port 3128 ssl-bump \\
  cert=/tmp/ca.crt \\
  key=/tmp/ca.key \\
  generate-host-certificates=on \\
  dynamic_cert_mem_cache_size=16MB \\
  options=NO_SSLv3,NO_TLSv1,NO_TLSv1_1
http_port [::]:3128 ssl-bump \\
  cert=/tmp/ca.crt \\
  key=/tmp/ca.key \\
  generate-host-certificates=on \\
  dynamic_cert_mem_cache_size=16MB \\
  options=NO_SSLv3,NO_TLSv1,NO_TLSv1_1

# SSL certificate database for dynamic certificate generation
# Using 16MB for certificate cache (sufficient for typical AI agent sessions)
sslcrtd_program /usr/lib/squid/security_file_certgen -s /tmp/ssl_db -M 16MB
sslcrtd_children 5

# SSL Bump ACL steps:
# Step 1 (SslBump1): Peek at ClientHello to get SNI
# Step 2 (SslBump2): Stare at server certificate to validate
# Step 3 (SslBump3): Bump or splice based on policy
acl step1 at_step SslBump1
acl step2 at_step SslBump2
acl step3 at_step SslBump3

# Peek at ClientHello to see SNI (Server Name Indication)
ssl_bump peek step1

# Splice the CLI proxy's scoped artifact-storage connections here (before staring
# or bumping) so signed Azure Blob URLs stay encrypted and the AWF-generated CA
# is never presented to the CLI proxy, which only trusts its system CA bundle.
ssl_bump splice from_cli_proxy cli_proxy_artifact_storage
# Stare at server certificate to validate it
ssl_bump stare step2

# Bump (intercept) connections to allowed domains
ssl_bump bump allowed_domains
ssl_bump bump allowed_domains_regex

# Terminate (deny) connections to non-allowed domains
ssl_bump terminate all

# URL pattern ACLs for HTTPS content inspection
acl allowed_url_0 url_regex https://github.com/api/*


# Network ACLs
acl localnet src 10.0.0.0/8
acl localnet src 172.16.0.0/12
acl localnet src 192.168.0.0/16
acl localnet src fc00::/7
acl localnet src fe80::/10

# Port ACLs
acl SSL_ports port 443
acl Safe_ports port 80          # HTTP
acl Safe_ports port 443         # HTTPS
acl CONNECT method CONNECT

# Access rules
# Deny unsafe ports (only allow Safe_ports defined above)
http_access deny !Safe_ports
# Allow CONNECT to Safe_ports instead of just SSL_ports (443)
# This is required because some HTTP clients (e.g., Node.js fetch) use CONNECT
# method even for HTTP connections when going through a proxy.
# See: gh-aw-firewall issue #189
http_access deny CONNECT !Safe_ports

# Deny CONNECT to raw IP addresses (IPv4 and IPv6)
# Prevents bypassing domain-based filtering via direct IP connections
acl dst_ipv4 dstdom_regex ^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$
acl dst_ipv6 dstdom_regex ^\\[?[0-9a-fA-F:]+\\]?$
http_access deny dst_ipv4
http_access deny dst_ipv6


# Allow HTTPS requests matching URL patterns
http_access allow allowed_url_0

# Deny requests that don't match URL patterns
http_access deny !CONNECT allowed_domains


# Allow the CLI proxy to follow GitHub artifact redirects without widening
# the agent's domain allowlist.
http_access allow from_cli_proxy cli_proxy_artifact_storage
# Deny requests to unknown domains (not in allow-list)
# This applies to all sources including localnet
http_access deny !allowed_domains !allowed_domains_regex

# Allow from trusted sources (after domain filtering)
http_access allow localnet
http_access allow localhost

# Deny everything else
http_access deny all

# Disable caching
cache deny all

# DNS settings - Squid resolves all domains for HTTP/HTTPS traffic
dns_nameservers 8.8.8.8 8.8.4.4
# A single transient upstream DNS failure (e.g. a SERVFAIL from an overloaded
# resolver during concurrent container startup) must not turn into a sustained
# false-positive block of an allowlisted domain. Squid's default
# negative_dns_ttl (1 minute) caches that one failure and rejects every
# request for the same domain for up to 60 seconds. Shrinking it means the
# very next lookup attempt re-queries the resolver instead of replaying the
# cached failure.
negative_dns_ttl 1 seconds
# Retry another configured nameserver quickly while keeping the total timeout
# above the retry interval. If dns_timeout is equal to Squid's default
# dns_retransmit_interval (5 seconds), Squid can hit the total timeout before
# sending the retry to the fallback nameserver.
dns_retransmit_interval 1 seconds
dns_timeout 10 seconds

# Forwarded headers
forwarded_for delete
via off

# Error page customization
error_directory /usr/share/squid/errors/en

# Memory and file descriptor limits
cache_mem 64 MB
maximum_object_size 0 KB

# Timeout settings for streaming/long-lived connections (AI inference APIs)
# read_timeout: Time to wait for data from server before giving up
# Increased to accommodate long AI inference calls and SSE streaming
read_timeout 30 minutes

# connect_timeout: Time to wait for TCP connection to origin server
connect_timeout 30 seconds

# request_timeout: Time to wait for client to send first request after connection
request_timeout 2 minutes

# persistent_request_timeout: Time to wait for next request on persistent connection
persistent_request_timeout 2 minutes

# pconn_timeout: How long to keep idle persistent connections to servers
pconn_timeout 2 minutes

# client_lifetime: Maximum time a client connection can be open
# Set high to accommodate long streaming sessions
client_lifetime 8 hours

# Close clients that send EOF before the TLS ClientHello to avoid Squid's
# empty-buffer assertion during ssl_bump peek. CONNECT tunnels handle half-close
# themselves, and SSE does not require a TCP half-close.
half_closed_clients off

# shutdown_lifetime: Time to wait for active connections during shutdown
# Set to 0 because this is an ephemeral proxy — no connection draining needed
shutdown_lifetime 0 seconds

# Debugging (can be enabled for troubleshooting)
# debug_options ALL,1 33,2
"
`;

exports[`generateSquidConfig golden output preserves combined policy and proxy sections byte-for-byte 1`] = `
"# Squid configuration for egress traffic control
# Generated by awf


# Disable pinger (ICMP) - requires NET_RAW capability which we don't have for security
pinger_enable off

# PID file location - use proxy-owned directory since container runs as non-root
pid_filename /var/run/squid/squid.pid

# Custom log format with detailed connection information
# Format: timestamp client_ip:port dest_domain dest_ip:port protocol method status decision url user_agent
# Note: For CONNECT requests (HTTPS), the domain is in the URL field
logformat firewall_detailed %ts.%03tu %>a:%>p %{Host}>h %<a:%<p %rv %rm %>Hs %Ss:%Sh %ru "%{User-Agent}>h"

# Structured JSONL audit log for machine-readable analysis
# Note: Squid logformat does not JSON-escape strings, so fields like User-Agent
# could break JSON parsing. We omit User-Agent to reduce breakage risk.
logformat audit_jsonl {"_schema":"audit/v0.0.0-test","timestamp":"%{%Y-%m-%dT%H:%M:%S}tg.%03tuZ","event":"http_access","client":"%>a","host":"%{Host}>h","dest":"%<a:%<p","method":"%rm","status":%>Hs,"decision":"%Ss","url":"%ru"}

# Access log and cache configuration
# Keep logs readable by the host runner for post-run redaction.
umask 022
# Don't log healthcheck probes from localhost (using ACL filter on access_log)
acl healthcheck_localhost src 127.0.0.1 ::1
acl sensitive_log_domains dstdomain .plain.example.com .secure.example.com .github.com
acl api_broker_log_0_source src 172.30.0.30/32
acl api_broker_log_0_destination dstdom_regex -i -n ^broker\\.example\\.com$
acl api_broker_log_0_port port 443
acl api_broker_log_0_private all-of api_broker_log_0_source api_broker_log_0_destination api_broker_log_0_port
acl api_broker_log_1_source src 172.30.0.30/32
acl api_broker_log_1_destination dst -n 192.0.2.2/32
acl api_broker_log_1_port port 8443
acl api_broker_log_1_private all-of api_broker_log_1_source api_broker_log_1_destination api_broker_log_1_port
access_log /var/log/squid/access.log firewall_detailed !healthcheck_localhost !sensitive_log_domains !api_broker_log_0_private !api_broker_log_1_private
access_log /var/log/squid/audit.jsonl audit_jsonl !healthcheck_localhost !sensitive_log_domains !api_broker_log_0_private !api_broker_log_1_private
cache_log /var/log/squid/cache.log
cache deny all

# ACL definitions for blocked domains
acl blocked_domains dstdomain .blocked.example.com

# ACL definitions for blocked domain patterns (wildcard)
acl blocked_domains_regex dstdom_regex -i ^[a-zA-Z0-9.-]*\\.blocked\\.example\\.org$

# ACL definitions for allowed domains (HTTP and HTTPS)
acl allowed_domains dstdomain .github.com
acl allowed_domains dstdomain .172.30.0.1

# ACL definitions for allowed domain patterns (HTTP and HTTPS)
acl allowed_domains_regex dstdom_regex -i ^[a-zA-Z0-9.-]*\\.example\\.org$

# ACL definitions for HTTP-only domains
acl allowed_http_only dstdomain .plain.example.com

# ACL definitions for HTTPS-only domains
acl allowed_https_only dstdomain .secure.example.com

# Exact host and port ACLs for configured OTLP collectors
acl otlp_endpoint_0_host dstdomain otel.example.com
acl otlp_endpoint_0_port port 4318
acl otlp_endpoint_1_host dstdomain otel.example.com
acl otlp_endpoint_1_port port 4317
acl otlp_endpoint_2_host dstdomain otel-http.example.com
acl otlp_endpoint_2_port port 80
acl otlp_endpoint_3_host dstdomain otel-https.example.com
acl otlp_endpoint_3_port port 443
acl from_cli_proxy src 172.30.0.50/32
acl cli_proxy_artifact_storage dstdomain .blob.core.windows.net

# DLP (Data Loss Prevention) ACL definitions
# Block requests containing credential patterns in URLs
acl dlp_blocked url_regex -i ghp_[a-zA-Z0-9]{36}
acl dlp_blocked url_regex -i gho_[a-zA-Z0-9]{36}
acl dlp_blocked url_regex -i ghs_[A-Za-z0-9._-]{36,}
acl dlp_blocked url_regex -i ghu_[a-zA-Z0-9]{36}
acl dlp_blocked url_regex -i github_pat_[a-zA-Z0-9]{22}_[a-zA-Z0-9]{59}
acl dlp_blocked url_regex -i sk-[a-zA-Z0-9]{20}T3BlbkFJ[a-zA-Z0-9]{20}
acl dlp_blocked url_regex -i sk-proj-[a-zA-Z0-9_-]{40,}
acl dlp_blocked url_regex -i sk-ant-[a-zA-Z0-9_-]{40,}
acl dlp_blocked url_regex (AKIA|ASIA)[0-9A-Z]{16}
acl dlp_blocked url_regex -i AIza[a-zA-Z0-9_-]{35}
acl dlp_blocked url_regex -i xoxb-[0-9]{10,13}-[0-9]{10,13}-[a-zA-Z0-9]{24}
acl dlp_blocked url_regex -i xoxp-[0-9]{10,13}-[0-9]{10,13}-[0-9]{10,13}-[a-f0-9]{32}
acl dlp_blocked url_regex -i [?&]bearer[_=][a-zA-Z0-9._-]{20,}
acl dlp_blocked url_regex -i [?&]authorization=[a-zA-Z0-9._-]{20,}
acl dlp_blocked url_regex -i PRIVATE(%20|\\+|%2B)KEY

# Port configuration

# TLS SNI allowlist enforcement
# Squid peeks only at the TLS ClientHello, then splices allowed connections
# without decrypting application traffic. The listener certificate is an
# ephemeral, untrusted bootstrap certificate and is never presented when these
# splice/terminate rules operate as configured.
http_port 3128 ssl-bump cert=/var/run/squid/awf-sni-guard-cert.pem key=/var/run/squid/awf-sni-guard-key.pem generate-host-certificates=off options=NO_SSLv3,NO_TLSv1,NO_TLSv1_1
http_port [::]:3128 ssl-bump cert=/var/run/squid/awf-sni-guard-cert.pem key=/var/run/squid/awf-sni-guard-key.pem generate-host-certificates=off options=NO_SSLv3,NO_TLSv1,NO_TLSv1_1

acl tls_sni_guard_step1 at_step SslBump1
acl tls_sni_guard_step2 at_step SslBump2
acl tls_sni_guard_port port 443
acl tls_sni_guard_allowed ssl::server_name --client-requested .github.com
acl tls_sni_guard_allowed ssl::server_name --client-requested .secure.example.com
acl tls_sni_guard_allowed_regex ssl::server_name_regex --client-requested -i ^[a-zA-Z0-9.-]*\\.example\\.org$
acl tls_sni_guard_blocked ssl::server_name --client-requested .blocked.example.com
acl tls_sni_guard_blocked_regex ssl::server_name_regex --client-requested -i ^[a-zA-Z0-9.-]*\\.blocked\\.example\\.org$
acl tls_sni_guard_allowed_ip dst -n 172.30.0.1
acl tls_sni_guard_api_proxy src 172.30.0.30/32
acl tls_sni_guard_cli_proxy src 172.30.0.50/32

# Trusted AWF-owned sidecars retain their existing scoped egress behavior.
ssl_bump splice tls_sni_guard_api_proxy
ssl_bump splice tls_sni_guard_cli_proxy
# CONNECT is also used for non-TLS traffic to explicitly allowed sidecar ports.
ssl_bump splice !tls_sni_guard_port
# Preserve explicit IP allowlisting for TLS clients, which normally omit SNI.
ssl_bump splice tls_sni_guard_step1 tls_sni_guard_allowed_ip

# For agent HTTPS traffic, inspect the ClientHello and require its actual SNI
# to be allowlisted. --client-requested prevents fallback to the CONNECT host
# when the client omits SNI.
ssl_bump peek tls_sni_guard_step1
ssl_bump terminate tls_sni_guard_step2 tls_sni_guard_blocked
ssl_bump terminate tls_sni_guard_step2 tls_sni_guard_blocked_regex
ssl_bump splice tls_sni_guard_step2 tls_sni_guard_allowed
ssl_bump splice tls_sni_guard_step2 tls_sni_guard_allowed_regex
ssl_bump terminate tls_sni_guard_step2
ssl_bump terminate all

# Network ACLs
acl localnet src 10.0.0.0/8
acl localnet src 172.16.0.0/12
acl localnet src 192.168.0.0/16
acl localnet src fc00::/7
acl localnet src fe80::/10

# Allow trusted topology peers (network-isolation mode) on any port before
# the Safe_ports and raw-IP deny rules. These are operator-attached
# containers (e.g. an MCP gateway) served on non-standard ports; clients
# that honour HTTP(S)_PROXY but ignore NO_PROXY reach them through Squid.
acl topology_peer_awmg_mcpg dstdomain .awmg-mcpg
http_access allow topology_peer_awmg_mcpg

# Exact custom-port upstreams for the trusted API proxy only.
acl api_upstream_source src 172.30.0.30/32
acl api_broker_connect method CONNECT
acl api_upstream_0_host dstdom_regex -i -n ^gateway\\.example\\.com$
acl api_upstream_0_port port 8443
http_access deny api_upstream_source api_upstream_0_host api_upstream_0_port blocked_domains
http_access deny api_upstream_source api_upstream_0_host api_upstream_0_port blocked_domains_regex
http_access deny api_upstream_source api_upstream_0_host api_upstream_0_port dlp_blocked
http_access allow api_upstream_source api_upstream_0_host api_upstream_0_port !blocked_domains !blocked_domains_regex !dlp_blocked
acl api_upstream_1_host dstdom_regex -i -n ^broker\\.example\\.com$
acl api_upstream_1_port port 443
http_access deny api_upstream_source api_upstream_1_host api_upstream_1_port blocked_domains
http_access deny api_upstream_source api_upstream_1_host api_upstream_1_port blocked_domains_regex
http_access deny api_upstream_source api_upstream_1_host api_upstream_1_port dlp_blocked
http_access allow api_upstream_source api_broker_connect api_upstream_1_host api_upstream_1_port !blocked_domains !blocked_domains_regex !dlp_blocked
acl api_upstream_2_host dst -n 192.0.2.2/32
acl api_upstream_2_port port 8443
http_access deny api_upstream_source api_upstream_2_host api_upstream_2_port blocked_domains
http_access deny api_upstream_source api_upstream_2_host api_upstream_2_port blocked_domains_regex
http_access deny api_upstream_source api_upstream_2_host api_upstream_2_port dlp_blocked
http_access allow api_upstream_source api_broker_connect api_upstream_2_host api_upstream_2_port !blocked_domains !blocked_domains_regex !dlp_blocked

# Port ACLs
acl SSL_ports port 443
acl Safe_ports port 80          # HTTP
acl Safe_ports port 443         # HTTPS
acl Safe_ports port 3000      # User-specified via --allow-host-ports
acl Safe_ports port 8080-8082      # User-specified via --allow-host-ports
acl CONNECT method CONNECT
acl Safe_ports port 10000     # AWF api-proxy sidecar
acl Safe_ports port 10001     # AWF api-proxy sidecar
acl Safe_ports port 10002     # AWF api-proxy sidecar
acl Safe_ports port 10003     # AWF api-proxy sidecar
acl Safe_ports port 4318     # OTLP collector endpoint
acl Safe_ports port 4317     # OTLP collector endpoint

# Access rules
# Deny unsafe ports (only allow Safe_ports defined above)
http_access deny !Safe_ports
# Allow CONNECT to Safe_ports instead of just SSL_ports (443)
# This is required because some HTTP clients (e.g., Node.js fetch) use CONNECT
# method even for HTTP connections when going through a proxy.
# See: gh-aw-firewall issue #189
http_access deny CONNECT !Safe_ports

# Allow connections to the AWF api-proxy sidecar before raw-IP deny rules.
# Some HTTP clients (e.g., Node.js fetch / undici ProxyAgent) route requests to
# the api-proxy via HTTP_PROXY without honouring NO_PROXY for raw IP addresses,
# causing them to arrive at Squid and be rejected by the raw-IP deny rule below.
# This allow rule fires first for the known api-proxy IP.
# -n matches literal IPs only, without resolving names before domain denial.
acl allow_api_proxy_ip dst -n 172.30.0.30
http_access allow allow_api_proxy_ip

# Allow the api-proxy sidecar unrestricted outbound through Squid.
# The sidecar must reach upstream API endpoints (e.g. api.anthropic.com for
# WIF/OIDC token exchange) that may not be in the agent's allow-list.
# The api-proxy is a trusted AWF component (not the agent threat model).
acl from_api_proxy src 172.30.0.30/32
http_access allow from_api_proxy

# Allow explicitly whitelisted IP addresses before raw-IP deny rules.
# When an operator adds a raw IP to --allow-domains (e.g. for the MCP gateway),
# it must be allowed through before the blanket dst_ipv4/dst_ipv6 deny.
acl allow_ip_172_30_0_1 dst -n 172.30.0.1
http_access allow allow_ip_172_30_0_1
# Deny CONNECT to raw IP addresses (IPv4 and IPv6)
# Prevents bypassing domain-based filtering via direct IP connections
acl dst_ipv4 dstdom_regex ^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$
acl dst_ipv6 dstdom_regex ^\\[?[0-9a-fA-F:]+\\]?$
http_access deny dst_ipv4
http_access deny dst_ipv6

# DLP: Deny requests containing detected credentials
http_access deny dlp_blocked


# Deny requests to blocked domains (blocklist takes precedence)
http_access deny blocked_domains
http_access deny blocked_domains_regex

# Protocol-specific domain access rules
http_access allow !CONNECT allowed_http_only
http_access allow CONNECT allowed_https_only
http_access allow CONNECT otlp_endpoint_0_host otlp_endpoint_0_port
http_access allow !CONNECT otlp_endpoint_1_host otlp_endpoint_1_port
http_access allow !CONNECT otlp_endpoint_2_host otlp_endpoint_2_port
http_access allow CONNECT otlp_endpoint_3_host otlp_endpoint_3_port
# Allow the CLI proxy to follow GitHub artifact redirects without widening
# the agent's domain allowlist.
http_access allow from_cli_proxy cli_proxy_artifact_storage
# Deny requests to unknown domains (not in allow-list)
# This applies to all sources including localnet
http_access deny !allowed_domains !allowed_domains_regex

# Allow from trusted sources (after domain filtering)
http_access allow localnet
http_access allow localhost

# Deny everything else
http_access deny all

# Disable caching
cache deny all

# DNS settings - Squid resolves all domains for HTTP/HTTPS traffic
dns_nameservers 1.1.1.1 1.0.0.1
# A single transient upstream DNS failure (e.g. a SERVFAIL from an overloaded
# resolver during concurrent container startup) must not turn into a sustained
# false-positive block of an allowlisted domain. Squid's default
# negative_dns_ttl (1 minute) caches that one failure and rejects every
# request for the same domain for up to 60 seconds. Shrinking it means the
# very next lookup attempt re-queries the resolver instead of replaying the
# cached failure.
negative_dns_ttl 1 seconds
# Retry another configured nameserver quickly while keeping the total timeout
# above the retry interval. If dns_timeout is equal to Squid's default
# dns_retransmit_interval (5 seconds), Squid can hit the total timeout before
# sending the retry to the fallback nameserver.
dns_retransmit_interval 1 seconds
dns_timeout 10 seconds

# Upstream corporate proxy — route outbound traffic through parent proxy
# Required for self-hosted runners where direct egress is blocked
cache_peer proxy.example.com parent 3128 0 no-query default

# Bypass upstream proxy for these domains (from host no_proxy)
acl upstream_bypass dstdomain .internal.example.com
always_direct allow upstream_bypass
never_direct allow all
# Forwarded headers
forwarded_for delete
via off

# Error page customization
error_directory /usr/share/squid/errors/en

# Memory and file descriptor limits
cache_mem 64 MB
maximum_object_size 0 KB

# Timeout settings for streaming/long-lived connections (AI inference APIs)
# read_timeout: Time to wait for data from server before giving up
# Increased to accommodate long AI inference calls and SSE streaming
read_timeout 30 minutes

# connect_timeout: Time to wait for TCP connection to origin server
connect_timeout 30 seconds

# request_timeout: Time to wait for client to send first request after connection
request_timeout 2 minutes

# persistent_request_timeout: Time to wait for next request on persistent connection
persistent_request_timeout 2 minutes

# pconn_timeout: How long to keep idle persistent connections to servers
pconn_timeout 2 minutes

# client_lifetime: Maximum time a client connection can be open
# Set high to accommodate long streaming sessions
client_lifetime 8 hours

# Close clients that send EOF before the TLS ClientHello to avoid Squid's
# empty-buffer assertion during ssl_bump peek. CONNECT tunnels handle half-close
# themselves, and SSE does not require a TCP half-close.
half_closed_clients off

# shutdown_lifetime: Time to wait for active connections during shutdown
# Set to 0 because this is an ephemeral proxy — no connection draining needed
shutdown_lifetime 0 seconds

# Debugging (can be enabled for troubleshooting)
# debug_options ALL,1 33,2
"
`;

exports[`generateSquidConfig golden output preserves default policy with empty optional lists byte-for-byte 1`] = `
"# Squid configuration for egress traffic control
# Generated by awf


# Disable pinger (ICMP) - requires NET_RAW capability which we don't have for security
pinger_enable off

# PID file location - use proxy-owned directory since container runs as non-root
pid_filename /var/run/squid/squid.pid

# Custom log format with detailed connection information
# Format: timestamp client_ip:port dest_domain dest_ip:port protocol method status decision url user_agent
# Note: For CONNECT requests (HTTPS), the domain is in the URL field
logformat firewall_detailed %ts.%03tu %>a:%>p %{Host}>h %<a:%<p %rv %rm %>Hs %Ss:%Sh %ru "%{User-Agent}>h"

# Structured JSONL audit log for machine-readable analysis
# Note: Squid logformat does not JSON-escape strings, so fields like User-Agent
# could break JSON parsing. We omit User-Agent to reduce breakage risk.
logformat audit_jsonl {"_schema":"audit/v0.0.0-test","timestamp":"%{%Y-%m-%dT%H:%M:%S}tg.%03tuZ","event":"http_access","client":"%>a","host":"%{Host}>h","dest":"%<a:%<p","method":"%rm","status":%>Hs,"decision":"%Ss","url":"%ru"}

# Access log and cache configuration
# Keep logs readable by the host runner for post-run redaction.
umask 022
# Don't log healthcheck probes from localhost (using ACL filter on access_log)
acl healthcheck_localhost src 127.0.0.1 ::1


access_log /var/log/squid/access.log firewall_detailed !healthcheck_localhost  
access_log /var/log/squid/audit.jsonl audit_jsonl !healthcheck_localhost  
cache_log /var/log/squid/cache.log
cache deny all

# ACL definitions for allowed domains (HTTP and HTTPS)
acl allowed_domains dstdomain .github.com


# Port configuration

# TLS SNI allowlist enforcement
# Squid peeks only at the TLS ClientHello, then splices allowed connections
# without decrypting application traffic. The listener certificate is an
# ephemeral, untrusted bootstrap certificate and is never presented when these
# splice/terminate rules operate as configured.
http_port 3128 ssl-bump cert=/var/run/squid/awf-sni-guard-cert.pem key=/var/run/squid/awf-sni-guard-key.pem generate-host-certificates=off options=NO_SSLv3,NO_TLSv1,NO_TLSv1_1
http_port [::]:3128 ssl-bump cert=/var/run/squid/awf-sni-guard-cert.pem key=/var/run/squid/awf-sni-guard-key.pem generate-host-certificates=off options=NO_SSLv3,NO_TLSv1,NO_TLSv1_1

acl tls_sni_guard_step1 at_step SslBump1
acl tls_sni_guard_step2 at_step SslBump2
acl tls_sni_guard_port port 443
acl tls_sni_guard_allowed ssl::server_name --client-requested .github.com




# Trusted AWF-owned sidecars retain their existing scoped egress behavior.

# CONNECT is also used for non-TLS traffic to explicitly allowed sidecar ports.
ssl_bump splice !tls_sni_guard_port
# Preserve explicit IP allowlisting for TLS clients, which normally omit SNI.


# For agent HTTPS traffic, inspect the ClientHello and require its actual SNI
# to be allowlisted. --client-requested prevents fallback to the CONNECT host
# when the client omits SNI.
ssl_bump peek tls_sni_guard_step1

ssl_bump splice tls_sni_guard_step2 tls_sni_guard_allowed
ssl_bump terminate tls_sni_guard_step2
ssl_bump terminate all

# Network ACLs
acl localnet src 10.0.0.0/8
acl localnet src 172.16.0.0/12
acl localnet src 192.168.0.0/16
acl localnet src fc00::/7
acl localnet src fe80::/10

# Port ACLs
acl SSL_ports port 443
acl Safe_ports port 80          # HTTP
acl Safe_ports port 443         # HTTPS
acl CONNECT method CONNECT

# Access rules
# Deny unsafe ports (only allow Safe_ports defined above)
http_access deny !Safe_ports
# Allow CONNECT to Safe_ports instead of just SSL_ports (443)
# This is required because some HTTP clients (e.g., Node.js fetch) use CONNECT
# method even for HTTP connections when going through a proxy.
# See: gh-aw-firewall issue #189
http_access deny CONNECT !Safe_ports

# Deny CONNECT to raw IP addresses (IPv4 and IPv6)
# Prevents bypassing domain-based filtering via direct IP connections
acl dst_ipv4 dstdom_regex ^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$
acl dst_ipv6 dstdom_regex ^\\[?[0-9a-fA-F:]+\\]?$
http_access deny dst_ipv4
http_access deny dst_ipv6



# Deny requests to unknown domains (not in allow-list)
# This applies to all sources including localnet
http_access deny !allowed_domains

# Allow from trusted sources (after domain filtering)
http_access allow localnet
http_access allow localhost

# Deny everything else
http_access deny all

# Disable caching
cache deny all

# DNS settings - Squid resolves all domains for HTTP/HTTPS traffic
dns_nameservers 8.8.8.8 8.8.4.4
# A single transient upstream DNS failure (e.g. a SERVFAIL from an overloaded
# resolver during concurrent container startup) must not turn into a sustained
# false-positive block of an allowlisted domain. Squid's default
# negative_dns_ttl (1 minute) caches that one failure and rejects every
# request for the same domain for up to 60 seconds. Shrinking it means the
# very next lookup attempt re-queries the resolver instead of replaying the
# cached failure.
negative_dns_ttl 1 seconds
# Retry another configured nameserver quickly while keeping the total timeout
# above the retry interval. If dns_timeout is equal to Squid's default
# dns_retransmit_interval (5 seconds), Squid can hit the total timeout before
# sending the retry to the fallback nameserver.
dns_retransmit_interval 1 seconds
dns_timeout 10 seconds

# Forwarded headers
forwarded_for delete
via off

# Error page customization
error_directory /usr/share/squid/errors/en

# Memory and file descriptor limits
cache_mem 64 MB
maximum_object_size 0 KB

# Timeout settings for streaming/long-lived connections (AI inference APIs)
# read_timeout: Time to wait for data from server before giving up
# Increased to accommodate long AI inference calls and SSE streaming
read_timeout 30 minutes

# connect_timeout: Time to wait for TCP connection to origin server
connect_timeout 30 seconds

# request_timeout: Time to wait for client to send first request after connection
request_timeout 2 minutes

# persistent_request_timeout: Time to wait for next request on persistent connection
persistent_request_timeout 2 minutes

# pconn_timeout: How long to keep idle persistent connections to servers
pconn_timeout 2 minutes

# client_lifetime: Maximum time a client connection can be open
# Set high to accommodate long streaming sessions
client_lifetime 8 hours

# Close clients that send EOF before the TLS ClientHello to avoid Squid's
# empty-buffer assertion during ssl_bump peek. CONNECT tunnels handle half-close
# themselves, and SSE does not require a TCP half-close.
half_closed_clients off

# shutdown_lifetime: Time to wait for active connections during shutdown
# Set to 0 because this is an ephemeral proxy — no connection draining needed
shutdown_lifetime 0 seconds

# Debugging (can be enabled for troubleshooting)
# debug_options ALL,1 33,2
"
`;

